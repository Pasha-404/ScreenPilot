<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.pavelkuzmin.screenpilot.app.ui.MainViewController" onDragOver="#acceptVideoDrop" onDragDropped="#dropMediaFiles" styleClass="application-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <padding><Insets top="18" right="24" bottom="18" left="24" /></padding>
            <VBox spacing="2">
                <Label text="ScreenPilot" styleClass="app-title" />
                <Label text="Управление видео на внешнем экране" styleClass="app-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox fx:id="topStatusPanel" spacing="2" styleClass="top-status">
                <Label fx:id="displayStatus" text="Ищу внешний экран" styleClass="status-title" />
                <Label fx:id="topologyStatus" text="Ожидание HDMI" styleClass="status-detail" />
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="18" styleClass="content-area">
                    <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>
                    <VBox spacing="10" styleClass="media-card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Текущий файл" styleClass="section-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="openMediaButton" text="Открыть файлы" onAction="#openMedia" styleClass="primary-outline-button" />
                        </HBox>
                        <Label fx:id="currentFile" text="Видео пока не выбрано" wrapText="true" styleClass="media-title" />
                        <Label fx:id="fileDetails" text="Добавьте локальные видеофайлы. На ноутбуке preview не создаётся." wrapText="true" styleClass="muted-label" />
                    </VBox>
                    <VBox spacing="12" styleClass="player-card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Воспроизведение" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="playbackTime" text="00:00 / --:--" styleClass="time-label" />
                        </HBox>
                        <Slider fx:id="progressSlider" value="0" onMouseReleased="#seekFromSlider" onKeyReleased="#seekFromKeyboard" accessibleText="Позиция воспроизведения" maxWidth="1.7976931348623157E308" />
                        <FlowPane alignment="CENTER" hgap="12" vgap="8">
                            <Button fx:id="previousButton" text="Предыдущее" onAction="#previousPlaylistItem" disable="true" styleClass="secondary-button" />
                            <Button fx:id="seekBackwardButton" text="−10 с" onAction="#seekBackward" disable="true" styleClass="secondary-button" />
                            <Button fx:id="pauseButton" text="Пауза" onAction="#togglePause" disable="true" styleClass="play-button" />
                            <Button fx:id="seekForwardButton" text="+10 с" onAction="#seekForward" disable="true" styleClass="secondary-button" />
                            <Button fx:id="nextButton" text="Следующее" onAction="#nextPlaylistItem" disable="true" styleClass="secondary-button" />
                            <Button fx:id="stopPlaybackButton" text="Стоп" onAction="#stopPlayback" disable="true" styleClass="secondary-button" />
                        </FlowPane>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Громкость" styleClass="field-label" />
                            <Slider fx:id="volumeSlider" value="100" onMouseReleased="#commitVolume" onKeyReleased="#commitVolumeFromKeyboard" accessibleText="Громкость" HBox.hgrow="ALWAYS" />
                            <Label fx:id="volumeValue" text="100%" styleClass="muted-label" />
                        </HBox>
                        <Label text="Space — пауза · ←/→ — ±10 с · Ctrl+←/→ — ±60 с · ↑/↓ — громкость · Esc — остановить вывод" wrapText="true" styleClass="muted-label" />
                    </VBox>
                    <VBox spacing="8" styleClass="feedback-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Статус" styleClass="section-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="Копировать диагностику" onAction="#copyDiagnostics" styleClass="link-button" />
                        </HBox>
                        <Label fx:id="feedback" text="Ищу подключённые внешние экраны…" wrapText="true" styleClass="feedback-text" />
                    </VBox>
                    <VBox fx:id="recoveryPanel" visible="false" managed="false" spacing="8" styleClass="recovery-card">
                        <Label text="Незавершённое восстановление экранов" styleClass="section-title" />
                        <Label fx:id="recoveryText" text="ScreenPilot найдёт сохранённую запись после запуска." wrapText="true" styleClass="feedback-text" />
                        <HBox spacing="8">
                            <Button fx:id="restoreRecoveryButton" text="Восстановить экраны" onAction="#restorePendingRecovery" styleClass="primary-button" />
                            <Button fx:id="keepCurrentConfigurationButton" text="Оставить как есть" onAction="#keepCurrentDisplayConfiguration" styleClass="secondary-button" />
                        </HBox>
                    </VBox>
                    <VBox spacing="10" styleClass="playlist-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Плейлист" styleClass="section-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="playlistSummary" text="Плейлист пуст" styleClass="muted-label" />
                        </HBox>
                        <ListView fx:id="playlistView" prefHeight="190" styleClass="playlist-list" />
                        <HBox spacing="8">
                            <Button fx:id="addPlaylistButton" text="Добавить файлы" onAction="#openMedia" styleClass="primary-outline-button" />
                            <Button fx:id="removePlaylistButton" text="Удалить" onAction="#removePlaylistItem" disable="true" styleClass="secondary-button" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="movePlaylistUpButton" text="↑" accessibleText="Переместить выбранный файл выше" onAction="#movePlaylistUp" disable="true" styleClass="secondary-button" />
                            <Button fx:id="movePlaylistDownButton" text="↓" accessibleText="Переместить выбранный файл ниже" onAction="#movePlaylistDown" disable="true" styleClass="secondary-button" />
                        </HBox>
                        <Label text="Можно добавить несколько файлов через Ctrl+O или перетащить их в окно. Для смены порядка перетащите строку либо используйте стрелки." wrapText="true" styleClass="muted-label" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefViewportWidth="310" styleClass="output-scroll">
            <content>
        <VBox prefWidth="310" spacing="12" styleClass="output-panel">
            <padding><Insets top="16" right="20" bottom="16" left="20" /></padding>
            <Label text="Вывод на внешний экран" styleClass="section-title" />
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Устройство" styleClass="field-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="refreshDisplaysButton" text="Обновить" onAction="#refreshDisplays" styleClass="link-button" />
                </HBox>
                <ComboBox fx:id="targetSelector" promptText="Ищу внешние экраны…" accessibleText="Внешний экран" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="6">
                <Label text="Режим экрана" styleClass="field-label" />
                <ComboBox fx:id="modeSelector" promptText="Сначала выберите экран" accessibleText="Режим экрана" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="6">
                <Label text="Масштабирование" styleClass="field-label" />
                <HBox spacing="6"><Button fx:id="fitButton" text="Вписать" onAction="#setFitScaling" disable="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" styleClass="secondary-button" /><Button fx:id="fillButton" text="Заполнить" onAction="#setFillScaling" disable="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" styleClass="secondary-button" /><Button fx:id="oneToOneButton" text="1:1" onAction="#setOneToOneScaling" disable="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" styleClass="secondary-button" /></HBox>
            </VBox>
            <VBox spacing="6">
                <Label text="Аудиовывод" styleClass="field-label" />
                <ComboBox fx:id="audioOutputSelector" disable="true" promptText="Доступно после запуска видео" accessibleText="Аудиовывод видео" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="6">
                <Label text="Аудиодорожка" styleClass="field-label" />
                <ComboBox fx:id="audioTrackSelector" disable="true" promptText="Доступно после запуска видео" accessibleText="Аудиодорожка" maxWidth="1.7976931348623157E308" />
            </VBox>
            <VBox spacing="6">
                <Label text="Субтитры" styleClass="field-label" />
                <ComboBox fx:id="subtitleSelector" disable="true" promptText="Доступно после запуска видео" accessibleText="Субтитры" maxWidth="1.7976931348623157E308" />
                <Button fx:id="addSubtitleButton" text="Подключить файл субтитров" onAction="#addSubtitle" disable="true" maxWidth="1.7976931348623157E308" styleClass="secondary-button" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="startOutputButton" text="Воспроизвести на внешнем экране" onAction="#startOutput" disable="true" maxWidth="1.7976931348623157E308" styleClass="primary-button" />
            <Button fx:id="stopOutputButton" text="Остановить вывод" onAction="#stopOutput" disable="true" maxWidth="1.7976931348623157E308" styleClass="danger-button" />
        </VBox>
            </content>
        </ScrollPane>
    </right>
</BorderPane>
